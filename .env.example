# Chave de API do Google Gemini (utilize a chave da sua conta Gemini Plus / Google AI Studio)
GEMINI_API_KEY=

# Caminho absoluto para a pasta do seu cofre no Obsidian (ex: C:/Users/Viktor/Documents/Meu-Vault)
# Se deixado em branco, o J.A.R.V.I.S criará e gerenciará um cofre local na pasta ./vault
OBSIDIAN_VAULT_PATH=

# Configurações de Rede IPC
WS_HOST=127.0.0.1
WS_PORT=8765
